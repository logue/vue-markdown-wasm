{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "vue-markdown-wasm",
  "description": "markdown-wasm for vue 2 & 3",
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "vue",
    "vue-markdown",
    "markdown",
    "markdown-wasm",
    "vue2",
    "vue3",
    "vue-component",
    "nuxt",
    "ssr",
    "server-side-rendering"
  ],
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/vue-markdown-wasm",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/vue-markdown-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/logue/vue-markdown-wasm/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js"
    },
    "./nuxt": {
      "import": "./dist/nuxt.js",
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "rslib --watch",
    "dev:docs": "rsbuild",
    "lint": "run-s lint:*",
    "lint:rslint": "rslint .",
    "lint:biome": "biome check --write",
    "type-check": "vue-tsc --noEmit -p tsconfig.rslib.json && vue-tsc --noEmit -p tsconfig.rsbuild.json && vue-tsc --noEmit -p tsconfig.rstest.json",
    "build": "rslib build",
    "build:docs": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf dist docs",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "dependencies": {
    "vue-demi": "latest"
  },
  "peerDependencies": {
    "@logue/markdown-wasm": ">=1.6.1",
    "@vue/composition-api": "^1.7.2",
    "vue": "^2.0.0 || >=3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@codemirror/lang-markdown": "^6.5.2",
    "@microsoft/api-extractor": "^7.59.0",
    "@rsbuild/core": "^2.2.1",
    "@rsbuild/plugin-node-polyfill": "^1.4.6",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.8.2",
    "@rstest/adapter-rsbuild": "^0.11.10",
    "@rstest/adapter-rslib": "^0.11.10",
    "@rstest/core": "^0.11.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.4.0",
    "@vue-devtools-rstack/rsbuild": "^0.1.0",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "bootstrap": "^5.3.8",
    "github-markdown-css": "^5.9.0",
    "happy-dom": "^20.12.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "vue": "^3.5.42",
    "vue-codemirror6": "^1.6.2",
    "vue-tsc": "^3.3.11"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json,yaml,yml,vue,htm,html,md}": "eslint --fix --cache",
    "*": "prettier -w -u"
  },
  "resolutions": {
    "lodash": ">=4.18.1",
    "rollup": ">=4.60.2"
  }
}
